.mooncakes/
target/

# Native toolchain by-products, wherever they land.
*.exe
*.obj
*.exp
*.lib
*.dll
*.pdb

# JavaScript dependencies for the diagnosis scripts in tools/.
node_modules/

# Python caches produced by tools/*.py.
__pycache__/
*.pyc

# Local editor and OS noise.
.DS_Store
Thumbs.db
