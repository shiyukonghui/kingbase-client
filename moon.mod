name = "shiyukonghui/kingbase-client"

version = "0.1.1"

readme = "README.mbt.md"

repository = "https://github.com/shiyukonghui/kingbase-client"

license = "Apache-2.0"

preferred_target = "native"

supported_targets = "native"

description = "KingbaseES client for MoonBit: PostgreSQL wire protocol 3.0, SCRAM-SHA-256, text COPY, and a dialect layer for the pg / oracle / mysql / sqlserver compatibility modes"

keywords = [ "kingbase", "database", "client", "wire-protocol", "scram" ]
