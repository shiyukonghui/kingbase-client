///| Black-box tests for the crypto package, validated against vectors
/// generated by Python's `hashlib`/`hmac`/`base64`.

///|
/// Local helper: hex-encode a Bytes value (not part of the public API).
fn bytes_to_hex(b : Bytes) -> String {
  let sb = StringBuilder()
  let digits = b"0123456789abcdef"
  let mut i = 0
  while i < b.length() {
    let v = b[i].to_int()
    sb.write_char(digits[(v >> 4) & 0xf].to_char())
    sb.write_char(digits[v & 0xf].to_char())
    i = i + 1
  }
  sb.to_string()
}

///|
/// Local helper: build a Bytes from a list of ints (test only).
fn bytes_from_ints(xs : Array[Int]) -> Bytes {
  let buf = Buffer()
  let mut i = 0
  while i < xs.length() {
    buf.write_byte(xs[i].to_byte())
    i = i + 1
  }
  buf.to_bytes()
}

///|
/// Local helper: compare two Bytes for content equality (test only).
fn bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    false
  } else {
    let mut ok = true
    let mut i = 0
    while i < a.length() {
      if a[i] != b[i] {
        ok = false
      }
      i = i + 1
    }
    ok
  }
}

///|
/// Local helper: a Bytes of `n` bytes each equal to `i` (test only).
fn bytes_range(n : Int) -> Bytes {
  let buf = Buffer()
  let mut i = 0
  while i < n {
    buf.write_byte(i.to_byte())
    i = i + 1
  }
  buf.to_bytes()
}

///|
test "sha256 empty" {
  let got = bytes_to_hex(@crypto.sha256(b""))
  assert_eq(
    got, "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
  )
}

///|
test "sha256 abc" {
  let got = bytes_to_hex(@crypto.sha256(b"abc"))
  assert_eq(
    got, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
  )
}

///|
test "sha256 multi-block (128 bytes)" {
  // "abcdefgh" * 16 exercises padding + the multi-block loop.
  let buf = Buffer()
  let mut i = 0
  while i < 16 {
    buf.write_string_utf8("abcdefgh")
    i = i + 1
  }
  let got = bytes_to_hex(@crypto.sha256(buf.to_bytes()))
  assert_eq(
    got, "4d86969d390610cfc6e446881e0aa18d1201863c6012d56c2f4d835185241f34",
  )
}

///|
test "hmac_sha256 RFC 4231 case 1" {
  // key = 20 bytes of 0x0b, msg = "Hi There"
  let key = bytes_from_ints(Array::make(20, 0x0b))
  let msg = b"Hi There"
  let got = bytes_to_hex(@crypto.hmac_sha256(key, msg))
  assert_eq(
    got, "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7",
  )
}

///|
test "pbkdf2 iterations 1" {
  let got = bytes_to_hex(
    @crypto.pbkdf2_hmac_sha256(b"password", b"salt", 1, 32),
  )
  assert_eq(
    got, "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b",
  )
}

///|
test "pbkdf2 iterations 4096 (KingbaseES server default)" {
  let got = bytes_to_hex(
    @crypto.pbkdf2_hmac_sha256(b"password", b"salt", 4096, 32),
  )
  assert_eq(
    got, "c5e478d59288c841aa530db6845c4c8d962893a001ce4e11a4963873aa98134a",
  )
}

///|
test "pbkdf2 multi-block dk_len 40" {
  // 40 bytes > 32 forces a second block whose counter is BE32(2).
  let got = bytes_to_hex(
    @crypto.pbkdf2_hmac_sha256(b"password", b"salt", 2, 40),
  )
  assert_eq(
    got, "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43830651afcb5c862f",
  )
}

///|
test "base64 round-trip all lengths 0..40" {
  let mut n = 0
  while n <= 40 {
    let xs : Array[Int] = []
    let mut i = 0
    while i < n {
      xs.push((i * 7 + i * i) % 256)
      i = i + 1
    }
    let data = bytes_from_ints(xs)
    let enc = @crypto.base64_encode(data)
    match @crypto.base64_decode(enc) {
      Ok(dec) =>
        assert_true(bytes_eq(data, dec), msg="round-trip failed len=\{n}")
      Err(e) => assert_true(false, msg="decode error len=\{n}: \{e}")
    }
    n = n + 1
  }
}

///|
test "base64 encode specific vectors" {
  // 22-byte nonce (22 % 3 == 1 -> two '=' of padding)
  assert_eq(
    @crypto.base64_encode(bytes_range(22)),
    "AAECAwQFBgcICQoLDA0ODxAREhMUFQ==",
  )
  // 24-byte nonce (24 % 3 == 0, no padding)
  assert_eq(
    @crypto.base64_encode(bytes_range(24)),
    "AAECAwQFBgcICQoLDA0ODxAREhMUFRYX",
  )
  // 16-byte salt (16 % 3 == 1 -> two '=' of padding)
  assert_eq(@crypto.base64_encode(bytes_range(16)), "AAECAwQFBgcICQoLDA0ODw==")
  // classic "abc" -> "YWJj"
  assert_eq(@crypto.base64_encode(b"abc"), "YWJj")
}

///|
test "base64 decode matches known vectors" {
  match @crypto.base64_decode("AAECAwQFBgcICQoLDA0ODxAREhMUFQ==") {
    Ok(b) =>
      assert_true(
        bytes_eq(b, bytes_range(22)),
        msg="22-byte nonce decode mismatch",
      )
    Err(e) => assert_true(false, msg="decode failed: \{e}")
  }
  match @crypto.base64_decode("AAECAwQFBgcICQoLDA0ODw==") {
    Ok(b) =>
      assert_true(
        bytes_eq(b, bytes_range(16)),
        msg="16-byte salt decode mismatch",
      )
    Err(e) => assert_true(false, msg="decode failed: \{e}")
  }
}

///|
test "base64 decode rejects malformed input" {
  let bad_len = match @crypto.base64_decode("YWJ") {
    Err(_) => true
    Ok(_) => false
  }
  assert_true(bad_len, msg="length not multiple of 4 must be rejected")
  let bad_char = match @crypto.base64_decode("Y*Jj") {
    Err(_) => true
    Ok(_) => false
  }
  assert_true(bad_char, msg="invalid character must be rejected")
  let pad_then_data = match @crypto.base64_decode("YWJj=abc") {
    Err(_) => true
    Ok(_) => false
  }
  assert_true(pad_then_data, msg="data after padding must be rejected")
}
